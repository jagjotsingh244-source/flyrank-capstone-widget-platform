# Server & Database Configuration
API_BASE_URL=http://localhost:8000
DATABASE_PATH=widget_platform.db

# Payload Boundaries & Security
MAX_PAYLOAD_SIZE_BYTES=65536
HONEYPOT_FIELD_NAME=_hp

# Abuse Protection & Rate Limiting (Per IP and Per Widget)
RATE_LIMIT_IP_BURST=10
RATE_LIMIT_IP_WINDOW_SECONDS=10
RATE_LIMIT_WIDGET_BURST=30
RATE_LIMIT_WIDGET_WINDOW_SECONDS=10

# Geolocation Fallback Chain (ip-api.com -> ipapi.co -> None)
GEO_TIMEOUT_SECONDS=3.0
GEO_MOCK_MODE=true

# Chaos Testing Switches for Acceptance Probes 4 & 5
GEO_FORCE_FAIL_A=false
GEO_FORCE_FAIL_B=false
EMAIL_FORCE_FAIL=false

# Background Notifications & Side Effects
NOTIFICATION_WEBHOOK_URL=https://webhook.site/placeholder-demo
ALERT_ON_BACKGROUND_FAILURE=true

# Customer Demo Site
DEMO_PORT=5500
